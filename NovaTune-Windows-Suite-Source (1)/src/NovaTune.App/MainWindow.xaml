<Window
    x:Class="NovaTune.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NovaTune">

    <NavigationView x:Name="Navigation" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavDashboard" Content="Dashboard" Tag="dashboard" Icon="Home" />
            <NavigationViewItem x:Uid="NavScan" Content="Smart Scan" Tag="scan" Icon="Find" />
            <NavigationViewItem x:Uid="NavClean" Content="Cleaning" Tag="clean" Icon="Delete" />
            <NavigationViewItem x:Uid="NavPerformance" Content="Performance" Tag="performance" Icon="SpeedHigh" />
            <NavigationViewItem x:Uid="NavRepair" Content="Windows Repair" Tag="repair" Icon="Repair" />
            <NavigationViewItem x:Uid="NavDisk" Content="Disk Analyzer" Tag="disk" Icon="Folder" />
            <NavigationViewItem x:Uid="NavSecurity" Content="Security" Tag="security" Icon="Shield" />
            <NavigationViewItem x:Uid="NavHardware" Content="Hardware" Tag="hardware" Icon="AllApps" />
        </NavigationView.MenuItems>

        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer x:Name="DashboardPage">
                <Grid Padding="32" RowSpacing="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Uid="Greeting" Text="Good evening" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="DashboardHeadline" Text="Your PC at a glance" FontSize="32" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button x:Uid="UndoButton" Content="Undo last cleanup" Command="{x:Bind ViewModel.UndoCommand}" />
                            <Button x:Uid="ScanButton" Content="Smart Scan" Command="{x:Bind ViewModel.SmartScanCommand}" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="HEALTH SCORE" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.HealthScore, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"/><ProgressBar Value="{x:Bind ViewModel.HealthScore, Mode=OneWay}" Maximum="100"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="PERFORMANCE" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.PerformanceScore, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"/><ProgressBar Value="{x:Bind ViewModel.PerformanceScore, Mode=OneWay}" Maximum="100"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="SECURITY" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.SecurityScore, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"/><ProgressBar Value="{x:Bind ViewModel.SecurityScore, Mode=OneWay}" Maximum="100"/></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="STORAGE" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.StorageScore, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"/><ProgressBar Value="{x:Bind ViewModel.StorageScore, Mode=OneWay}" Maximum="100"/></StackPanel></Border>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.CpuPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}" Style="{StaticResource MetricValueStyle}"/><ProgressBar Value="{x:Bind ViewModel.CpuPercent, Mode=OneWay}" Maximum="100"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.MemoryPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}" Style="{StaticResource MetricValueStyle}"/><ProgressBar Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" Maximum="100"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="SYSTEM DISK" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.DiskPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}" Style="{StaticResource MetricValueStyle}"/><ProgressBar Value="{x:Bind ViewModel.DiskPercent, Mode=OneWay}" Maximum="100"/></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="NETWORK" Style="{StaticResource MetricTitleStyle}"/><TextBlock Text="{x:Bind ViewModel.NetworkText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,8"/><ProgressBar IsIndeterminate="True"/></StackPanel></Border>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <Grid><TextBlock Text="Smart Scan" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
                                <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}" Maximum="100" Height="6"/>
                                <ListView ItemsSource="{x:Bind ViewModel.Issues}" MaxHeight="240">
                                    <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Explanation}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14"><TextBlock Text="Private diagnostics" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Analysis runs locally on this PC" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ListView ItemsSource="{x:Bind ViewModel.Insights}" MaxHeight="240"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Headline}" FontWeight="SemiBold"/><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Uid="SafeCleanupTitle" Text="Safe cleanup" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Uid="SafeCleanupDescription" Text="Preview allow-listed caches. Files are quarantined and can be restored." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.CleanupBytes, Mode=OneWay}" Visibility="Collapsed"/></StackPanel>
                            <Button x:Uid="PreviewButton" Grid.Column="1" Content="Preview cleanup" Click="PreviewCleanup_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="ModulePage" Visibility="Collapsed" Padding="40">
                <Border Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="14"><FontIcon Glyph="&#xE946;" FontSize="36"/><TextBlock x:Name="ModuleTitle" Text="Module" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="This module is wired into the product architecture and scheduled for a hardened implementation. NovaTune will not simulate system changes or expose unsafe one-click tweaks." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Border>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
